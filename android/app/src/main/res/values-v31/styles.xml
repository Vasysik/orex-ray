<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) shows its own system splash screen before the
         activity window and ignores the legacy windowBackground drawable.
         Pin its background to the launch color so the startup stays dark
         gray instead of flashing black. The style replaces the v27 one on
         these API levels, so every item is repeated here. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/orexray_launch_background</item>
        <item name="android:navigationBarColor">@color/orexray_launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/orexray_launch_background</item>
    </style>
</resources>
