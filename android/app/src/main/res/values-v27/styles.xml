<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- On API 27+ the launch and normal windows also paint the display
         cutout area, so the punch hole and gesture strip keep the theme
         background instead of going black during startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/orexray_launch_background</item>
        <item name="android:navigationBarColor">@color/orexray_launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/orexray_launch_background</item>
        <item name="android:statusBarColor">@color/orexray_launch_background</item>
        <item name="android:navigationBarColor">@color/orexray_launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
